gzip \
rsync \
less \
nano \
iproute \
iputils \
bind-utils \
traceroute \
nmap-ncat \
tcpdump \
lsof \
file"

JUSTVOXEL_BAREMETAL_PACKAGES="\
nut \
nut-client \
btrfs-progs \
smartmontools \
