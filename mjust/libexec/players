#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
require_root
require_config

if ! systemctl is-active --quiet minecraft.service; then
    echo 'Minecraft is stopped.'
    echo 'Player information is unavailable until the server is running.'
    exit 0
fi

players="$(podman exec minecraft rcon-cli 'list' 2>/dev/null || true)"
if [[ -z ${players} ]]; then
    echo 'Players: Unknown'
    echo 'RCON player query failed.'
    exit 1
fi

if [[ ${players} =~ There[[:space:]]are[[:space:]]([0-9]+)[[:space:]]of[[:space:]]a[[:space:]]max[[:space:]]of[[:space:]]([0-9]+)[[:space:]]players[[:space:]]online:?([[:space:]]*)(.*) ]]; then
    online="${BASH_REMATCH[1]}"
    maximum="${BASH_REMATCH[2]}"
    names="${BASH_REMATCH[4]}"
    echo "Players online: ${online} / ${maximum}"
    if (( online == 0 )); then
        echo 'No players are currently online.'
    elif [[ -n ${names} ]]; then
        echo "Online: ${names}"
    else
        echo "${players}"
    fi
else
    echo "${players}"
fi
