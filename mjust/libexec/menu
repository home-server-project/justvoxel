#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/ui.sh

configured=no
[[ -e /etc/containers/systemd/minecraft.container ]] && configured=yes

preview() {
    case "${1:-}" in
        setup)
            cat <<'TEXT'
First setup

Configure Minecraft, memory, ports, Bedrock cross-play, storage and backups.
Normal setup chooses safe defaults and keeps Linux-specific detail out of the way.

Command:
  mjust setup
TEXT
            ;;
        import)
            cat <<'TEXT'
Import existing Minecraft server

Migrate an existing JustVoxel, Paper or itzg/minecraft-server Paper server into
this appliance. Import accepts a directory, tar/tar.gz archive, ZIP export,
attached storage, USB, configured backup storage, or temporary NFS/SMB share.

Fresh imports still require explicit Minecraft EULA acceptance.

Command:
  mjust import
TEXT
            ;;
        setup-advanced)
            cat <<'TEXT'
Advanced setup

Use the same first-setup flow with advanced controls such as custom numeric
Minecraft data UID/GID values and raw systemd backup schedules.

Command:
  mjust setup-advanced
TEXT
            ;;
        status)
            cat <<'TEXT'
Status

Show the friendly JustVoxel appliance health dashboard: system services,
Minecraft, players, network, storage, backups and container state.

Read-only. Detailed administrator output remains available with:
  mjust status --details
TEXT
            ;;
        players)
            cat <<'TEXT'
Players

Show the current Minecraft player list through the server's internal RCON
connection. RCON is not exposed as a host network port.

Command:
  mjust players
TEXT
            ;;
        configure)
            cat <<'TEXT'
Configure Minecraft

Change supported Minecraft settings after first setup. Maximum players has its
own guided screen; other settings remain available through the safe configure
flow. Configuration changes never force an automatic disruptive restart.

Commands:
  mjust configure-max-players
  mjust configure
TEXT
            ;;
        whitelist)
            cat <<'TEXT'
Whitelist

Manage Java Edition and Bedrock/Xbox players.

Java: use the Minecraft Java username, for example PlayerOne.
Bedrock: use the Xbox/Bedrock gamertag, for example BedrockBuddy.
Do not manually type the Floodgate prefix; Floodgate may internally show
BedrockBuddy as .BedrockBuddy.
TEXT
            ;;
        service)
            cat <<'TEXT'
Start / Stop / Restart

Control Minecraft service state. Stop and restart check player state first and
fail closed if JustVoxel cannot confirm whether players are online.

Commands:
  mjust start
  mjust stop
  mjust restart
TEXT
            ;;
        backups)
            cat <<'TEXT'
Backups

Create a verified cold backup or restore Minecraft data from an existing
JustVoxel backup.

Restore world rolls back the primary world and normal world-based player data
while keeping current plugins and server/JustVoxel configuration.

Restore full Minecraft data replaces the complete persistent Minecraft data
directory, including plugins and Minecraft-side configuration. The current data
is kept as a pre-restore safety copy until the restored server validates.

Commands:
  mjust backup
  mjust restore
  mjust restore-full
TEXT
            ;;
        migration)
            cat <<'TEXT'
Migration

Export one portable JustVoxel server migration bundle or import an existing
JustVoxel/Paper server. Migration preserves the complete persistent Minecraft
server data while recreating destination-specific machine configuration safely.

If an interrupted import leaves protected recovery state, use the guided
recovery flow to validate the restored server and finalize that rollback before
starting another import.

Backup/Restore remains separate from Migration.

Commands:
  mjust export
  mjust import
  mjust migration-recover
TEXT
            ;;
        storage)
            cat <<'TEXT'
Storage

Manage backup storage and guarded Minecraft data migration. Every storage path
is also available as a direct mjust command. Destructive disk operations keep
exact typed confirmations such as ERASE /dev/...

Commands include:
  mjust storage-disk
  mjust storage-partition
  mjust storage-free-space
  mjust storage-network
  mjust storage-system
  mjust storage-migrate
  mjust storage-plan
TEXT
            ;;
        update)
            cat <<'TEXT'
Update Minecraft

Check both the configured Minecraft container image and the Minecraft/Paper
game-version policy. A newer stable Paper-supported version is shown clearly
and can be re-pinned only after explicit approval.

Before changing a running server, JustVoxel checks players, creates a verified
cold backup, applies the selected maintenance and verifies the running server.

Command:
  mjust update-minecraft
TEXT
            ;;
        system)
            cat <<'TEXT'
System

Manage the JustVoxel OS, live system resources and appliance power safely.
OS update checks/downloads do not stop Minecraft, create a backup, or reboot.
A normal reboot later uses any bootc deployment that is already staged.

System resources opens btop for a live view of CPU, memory/swap, disks,
network activity and processes. Press q to return to JustVoxel. Esc opens the
btop menu, and Ctrl-C also exits the monitor.

Commands:
  mjust os-status
  mjust os-update
  mjust resources
  mjust reboot
  mjust poweroff
  mjust firmware

Firmware/UEFI reboot is shown in the menu only on Bare Metal.
TEXT
            ;;
        validate)
            cat <<'TEXT'
Validation

Run the full JustVoxel deployment validation: configuration, storage identity,
SELinux, firewall, zram, systemd state, RCON, Minecraft and Bedrock support.
Zram policy differences are advisory so administrator swap choices do not make
an otherwise healthy appliance fail validation.

Command:
  mjust validate
TEXT
            ;;
        logs)
            cat <<'TEXT'
Logs

Follow the Minecraft systemd journal for troubleshooting.
Press q or Esc to return to the JustVoxel menu. Ctrl-C also exits the viewer.

Command:
  mjust logs
TEXT
            ;;
        advanced)
            cat <<'TEXT'
Advanced

Administrator-oriented tools: detailed status, storage-plan view, login welcome
controls, the complete mjust command list, and guarded Start over/reset.

Start over preserves Minecraft world data and existing backup archives.
TEXT
            ;;
        exit) echo 'Exit the JustVoxel menu.' ;;
        *) echo 'Unknown menu item.' ;;
    esac
}

if [[ ${1:-} == --preview ]]; then
    preview "${2:-}"
    exit 0
fi

show_noninteractive_help() {
    cat <<'TEXT'
JustVoxel mjust

Interactive menu unavailable because this session has no usable TTY.
Use a direct command instead, for example:
  mjust status
  mjust players
  mjust configure
  mjust configure-max-players
  mjust whitelist-list
  mjust backup
  mjust restore
  mjust restore-full
  mjust export
  mjust import
  mjust migration-recover
  mjust storage
  mjust update-minecraft
  mjust os-status
  mjust os-update
  mjust resources
  mjust reboot
  mjust poweroff
  mjust validate
  mjust logs
  mjust --list

For an SSH menu, allocate a terminal, for example: ssh -t <host> mjust
TEXT
}

if ! jui_is_interactive; then
    show_noninteractive_help
    exit 0
fi

run_and_pause() {
    "$@"
    local rc=$?
    jui_pause
    return "${rc}"
}

service_menu() {
    local choice
    choice="$(jui_choose 'Minecraft service' 'Start Minecraft' 'Stop Minecraft' 'Restart Minecraft' 'Back')" || return 0
    case "${choice}" in
        'Start Minecraft') run_and_pause /usr/bin/mjust start || true ;;
        'Stop Minecraft') run_and_pause /usr/bin/mjust stop || true ;;
        'Restart Minecraft') run_and_pause /usr/bin/mjust restart || true ;;
        *) return 0 ;;
    esac
}

configure_menu() {
    local choice
    choice="$(jui_choose 'Configure Minecraft' 'Maximum players' 'Other safe Minecraft settings' 'Back')" || return 0
    case "${choice}" in
        'Maximum players') run_and_pause /usr/bin/mjust configure-max-players || true ;;
        'Other safe Minecraft settings') run_and_pause /usr/bin/mjust configure || true ;;
        *) return 0 ;;
    esac
}

whitelist_menu() {
    local choice name
    while true; do
        choice="$(jui_choose 'Whitelist' 'Show whitelist' 'Add Java player' 'Remove Java player' 'Add Bedrock / Xbox player' 'Remove Bedrock / Xbox player' 'Back')" || return 0
        case "${choice}" in
            'Show whitelist') run_and_pause /usr/bin/mjust whitelist-list || true ;;
            'Add Java player')
                echo 'Use the Minecraft Java username. Example: PlayerOne'
                name="$(jui_input 'Java username')" || continue
                [[ -n ${name} ]] && run_and_pause /usr/bin/mjust whitelist-add-java "${name}" || true
                ;;
            'Remove Java player')
                echo 'Use the Minecraft Java username. Example: BlockBuilder'
                name="$(jui_input 'Java username')" || continue
                [[ -n ${name} ]] && run_and_pause /usr/bin/mjust whitelist-remove-java "${name}" || true
                ;;
            'Add Bedrock / Xbox player')
                echo 'Use the Xbox/Bedrock gamertag. Example: BedrockBuddy'
                echo 'Do not type the Floodgate prefix; .BedrockBuddy is only an internal example.'
                name="$(jui_input 'Bedrock / Xbox gamertag')" || continue
                [[ -n ${name} ]] && run_and_pause /usr/bin/mjust whitelist-add-bedrock "${name}" || true
                ;;
            'Remove Bedrock / Xbox player')
                echo 'Use the Xbox/Bedrock gamertag. Example: PixelPlayer'
                echo 'Do not type the Floodgate prefix.'
                name="$(jui_input 'Bedrock / Xbox gamertag')" || continue
                [[ -n ${name} ]] && run_and_pause /usr/bin/mjust whitelist-remove-bedrock "${name}" || true
                ;;
            'Back') return 0 ;;
        esac
    done
}

backup_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Backups' 'Create backup' 'Restore world' 'Restore full Minecraft data' 'Back')" || return 0
        case "${choice}" in
            'Create backup') run_and_pause /usr/bin/mjust backup || true ;;
            'Restore world') run_and_pause /usr/bin/mjust restore || true ;;
            'Restore full Minecraft data') run_and_pause /usr/bin/mjust restore-full || true ;;
            'Back') return 0 ;;
        esac
    done
}

migration_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Migration' 'Export server' 'Import server' 'Recover / finalize interrupted import' 'Back')" || return 0
        case "${choice}" in
            'Export server') run_and_pause /usr/bin/mjust export || true ;;
            'Import server') run_and_pause /usr/bin/mjust import || true ;;
            'Recover / finalize interrupted import') run_and_pause /usr/bin/mjust migration-recover || true ;;
            'Back') return 0 ;;
        esac
    done
}

storage_menu() {
    local choice
    while true; do
        choice="$(jui_choose 'Storage' 'Dedicated disk / USB backup storage' 'Existing partition / filesystem backup storage' 'Use unallocated disk space for backup storage' 'Network backup storage (NFS / SMB)' 'Directory on the system filesystem' 'Migrate Minecraft data' 'Storage plan / devices' 'Back')" || return 0
        case "${choice}" in
            'Dedicated disk / USB backup storage') run_and_pause /usr/bin/mjust storage-disk || true ;;
            'Existing partition / filesystem backup storage') run_and_pause /usr/bin/mjust storage-partition || true ;;
            'Use unallocated disk space for backup storage') run_and_pause /usr/bin/mjust storage-free-space || true ;;
            'Network backup storage (NFS / SMB)') run_and_pause /usr/bin/mjust storage-network || true ;;
            'Directory on the system filesystem') run_and_pause /usr/bin/mjust storage-system || true ;;
            'Migrate Minecraft data')
                if [[ ${configured} == yes ]]; then run_and_pause /usr/bin/mjust storage-migrate || true; else echo 'Minecraft data migration is available after first setup.'; jui_pause; fi
                ;;
            'Storage plan / devices') run_and_pause /usr/bin/mjust storage-plan || true ;;
            'Back') return 0 ;;
        esac
    done
}

system_menu() {
    local variant choice
    local -a options=('Operating system status' 'Check / download OS update' 'System resources' 'Reboot JustVoxel' 'Power off JustVoxel')
    variant="$(cat /usr/lib/justvoxel/variant 2>/dev/null || true)"
    [[ ${variant} == *baremetal* ]] && options+=('Firmware / UEFI setup')
    options+=('Back')

    while true; do
        choice="$(jui_choose 'System' "${options[@]}")" || return 0
        case "${choice}" in
            'Operating system status')
                /usr/bin/mjust os-status || true
                echo
                if jui_confirm 'Check for OS updates now?'; then /usr/bin/mjust os-update || true; fi
                jui_pause
                ;;
            'Check / download OS update') run_and_pause /usr/bin/mjust os-update || true ;;
            'System resources') /usr/bin/mjust resources || true ;;
            'Reboot JustVoxel') run_and_pause /usr/bin/mjust reboot || true ;;
            'Power off JustVoxel') run_and_pause /usr/bin/mjust poweroff || true ;;
            'Firmware / UEFI setup') run_and_pause /usr/bin/mjust firmware || true ;;
            'Back') return 0 ;;
        esac
    done
}

all_commands() {
    echo 'All mjust commands'
    echo '------------------'
    /usr/bin/mjust --list
}

advanced_menu() {
    local -a options=('Detailed status' 'Storage plan / devices' 'Show login welcome' 'Hide login welcome' 'Enable login welcome' 'All mjust commands')
    if [[ ${configured} == yes ]]; then options+=('Start over / reset Minecraft'); else options=('Advanced first setup' "${options[@]}"); fi
    options+=('Back')

    local choice
    choice="$(jui_choose 'Advanced' "${options[@]}")" || return 0
    case "${choice}" in
        'Advanced first setup') run_and_pause /usr/bin/mjust setup-advanced || true ;;
        'Detailed status') run_and_pause /usr/bin/mjust status --details || true ;;
        'Storage plan / devices') run_and_pause /usr/bin/mjust storage-plan || true ;;
        'Show login welcome') run_and_pause /usr/bin/mjust welcome || true ;;
        'Hide login welcome') run_and_pause /usr/bin/mjust welcome-off || true ;;
        'Enable login welcome') run_and_pause /usr/bin/mjust welcome-on || true ;;
        'All mjust commands') all_commands; jui_pause ;;
        'Start over / reset Minecraft') run_and_pause /usr/bin/mjust start-over || true ;;
        *) return 0 ;;
    esac
}

select_rich() {
    local rows selected
    if [[ ${configured} == yes ]]; then
        rows=$'status\tStatus\nplayers\tPlayers\nconfigure\tConfigure Minecraft\nservice\tStart / Stop / Restart\nwhitelist\tWhitelist\nbackups\tBackups\nmigration\tMigration\nstorage\tStorage\nupdate\tUpdate Minecraft\nsystem\tSystem\nvalidate\tValidation\nlogs\tLogs\nadvanced\tAdvanced\nexit\tExit'
    else
        rows=$'setup\tFirst setup\nimport\tImport existing Minecraft server\nstatus\tStatus\nstorage\tStorage\nsystem\tSystem\nsetup-advanced\tAdvanced setup\nexit\tExit'
    fi
    selected="$(printf '%s\n' "${rows}" | fzf --delimiter=$'\t' --with-nth=2 --no-multi --layout=reverse --border --height=90% --prompt='JustVoxel > ' --preview='/usr/libexec/justvoxel/mjust/menu --preview {1}' --preview-window='right,55%,wrap,border-left' || true)"
    [[ -n ${selected} ]] || { printf 'exit'; return 0; }
    printf '%s' "${selected%%$'\t'*}"
}

select_compact() {
    local choice
    if [[ ${configured} == yes ]]; then
        choice="$(jui_choose 'JustVoxel' 'Status' 'Players' 'Configure Minecraft' 'Start / Stop / Restart' 'Whitelist' 'Backups' 'Migration' 'Storage' 'Update Minecraft' 'System' 'Validation' 'Logs' 'Advanced' 'Exit')" || { printf 'exit'; return 0; }
        case "${choice}" in
            'Status') printf 'status' ;; 'Players') printf 'players' ;; 'Configure Minecraft') printf 'configure' ;; 'Start / Stop / Restart') printf 'service' ;;
            'Whitelist') printf 'whitelist' ;; 'Backups') printf 'backups' ;; 'Migration') printf 'migration' ;; 'Storage') printf 'storage' ;; 'Update Minecraft') printf 'update' ;; 'System') printf 'system' ;;
            'Validation') printf 'validate' ;; 'Logs') printf 'logs' ;; 'Advanced') printf 'advanced' ;; *) printf 'exit' ;;
        esac
    else
        choice="$(jui_choose 'JustVoxel' 'First setup' 'Import existing Minecraft server' 'Status' 'Storage' 'System' 'Advanced setup' 'Exit')" || { printf 'exit'; return 0; }
        case "${choice}" in 'First setup') printf 'setup' ;; 'Import existing Minecraft server') printf 'import' ;; 'Status') printf 'status' ;; 'Storage') printf 'storage' ;; 'System') printf 'system' ;; 'Advanced setup') printf 'setup-advanced' ;; *) printf 'exit' ;; esac
    fi
}

while true; do
    [[ -e /etc/containers/systemd/minecraft.container ]] && configured=yes || configured=no
    if jui_rich_supported; then action="$(select_rich)"; else action="$(select_compact)"; fi
    echo
    case "${action}" in
        setup) run_and_pause /usr/bin/mjust setup || true ;;
        import) run_and_pause /usr/bin/mjust import || true ;;
        setup-advanced) run_and_pause /usr/bin/mjust setup-advanced || true ;;
        status) run_and_pause /usr/bin/mjust status || true ;;
        players) run_and_pause /usr/bin/mjust players || true ;;
        configure) configure_menu ;;
        service) service_menu ;;
        whitelist) whitelist_menu ;;
        backups) backup_menu ;;
        migration) migration_menu ;;
        storage) storage_menu ;;
        update) run_and_pause /usr/bin/mjust update-minecraft || true ;;
        system) system_menu ;;
        validate) run_and_pause /usr/bin/mjust validate || true ;;
        logs) /usr/bin/mjust logs || true ;;
        advanced) advanced_menu ;;
        exit) exit 0 ;;
        *) echo 'Unknown menu selection.' >&2 ;;
    esac
done
