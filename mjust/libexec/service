#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/interrupt-safety.sh
require_root
require_config

action="${1:-}"

case "${action}" in
    start)
        systemctl start minecraft.service
        echo 'Minecraft start requested.'
        ;;
    stop)
        jv_player_check_before_interrupt 'Stop Minecraft'
        systemctl stop minecraft.service
        echo 'Minecraft stopped.'
        ;;
    restart)
        jv_player_check_before_interrupt 'Restart Minecraft'
        systemctl restart minecraft.service
        echo 'Minecraft restarted.'
        ;;
    *)
        echo 'Usage: service {start|stop|restart}' >&2
        exit 2
        ;;
esac
