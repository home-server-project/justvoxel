#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
require_root
switch_verification=no
if [[ ${1:-} == --instance && ( ${3:-} == --switch || ${3:-} == --switch-clone ) ]]; then
    switch_verification=yes
fi

# Switch exit statuses are mapped to fixed diagnostics in
# pluginRuntimeVerificationError.diagnosticCode. Other callers keep exit 1.
verification_failed() {
    if [[ -n ${2:-} ]]; then printf '%s\n' "${2}" >&2; fi
    if [[ ${switch_verification} == yes ]]; then exit "$1"; fi
    exit 1
}
if [[ ${1:-} == --instance ]]; then
    [[ $# -ge 2 ]] || exit 1
    source /usr/libexec/justvoxel/mjust/instance-context.sh
    jv_load_instance "$2" || verification_failed 40
    shift 2
else
    require_config
    JV_INSTANCE_CONTAINER=minecraft
    JV_INSTANCE_UNIT=minecraft.service
fi
content_install=no
runtime_only=no
case "${1:-}" in
    --content-install) content_install=yes; shift ;;
    --switch|--switch-clone)
        [[ ${switch_verification} == yes && -n ${JV_INSTANCE_ID:-} && ${JV_NETWORK_MEMBER} == no && $# == 2 &&
           ( $2 == "${MINECRAFT_VERSION}" || $2 == LATEST || ${MINECRAFT_VERSION} == LATEST ) ]] || verification_failed 40
        if [[ ${BEDROCK_ENABLED} == no ]]; then runtime_only=yes; fi
        shift
        ;;
esac
if [[ ${JUSTVOXEL_MAINTENANCE_LOCK_HELD:-0} != 1 ]]; then
    exec 9>"${JV_MAINTENANCE_LOCK}"
    flock -n 9 || { echo 'ERROR: another Minecraft maintenance operation is running.' >&2; exit 1; }
fi
rcon_timeout=60
case "${MINECRAFT_SERVER_TYPE-paper}" in spigot|forge|neoforge|fabric|quilt) rcon_timeout=900 ;; esac
if [[ ${switch_verification} == yes ]]; then rcon_timeout=900; fi
wait_for_rcon "${rcon_timeout}" || {
    if [[ $? == 2 ]]; then
        verification_failed 51 'ERROR: Minecraft service stopped before RCON became ready.'
    fi
    verification_failed 49 'ERROR: Minecraft RCON is not ready.'
}
expected_version="${1:-${MINECRAFT_VERSION}}"
probe_container="${JV_INSTANCE_CONTAINER}"
if [[ ${switch_verification} == yes ]]; then
    inspect_running_session() {
        local fields running id started utc
        # Slurp to reject extra JSON values as well as extra records. Validate
        # the strings before passing any fields from JSON back to Bash.
        fields="$(podman container inspect "${JV_INSTANCE_CONTAINER}" 2>/dev/null | jq -ers '
            def matches($pattern): if type == "string" then test($pattern) else false end;
            def timestamp:
                "\\A[0-9]{4}-[0-9]{2}-[0-9]{2}T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]" +
                "(\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])\\z";
            select(length == 1) | .[0]
            | select(type == "array" and length == 1) | .[0]
            | select(type == "object" and (.State | type == "object") and (.State.Running | type == "boolean"))
            | if (.Id | matches("\\A[a-f0-9]{64}\\z")) and (.State.StartedAt | matches(timestamp))
              then [.State.Running, .Id, .State.StartedAt] | @tsv
              else "" end
        ' 2>/dev/null)" || verification_failed 41
        [[ -n ${fields} ]] || verification_failed 42
        IFS=$'\t' read -r running id started <<< "${fields}"
        utc="$(LC_ALL=C date -u --date="${started}" '+%Y-%m-%dT%H:%M:%S.%NZ' 2>/dev/null)" || verification_failed 42
        [[ ${utc} != 0001-01-01T00:00:00.000000000Z ]] || verification_failed 42
        [[ ${running} == true ]] || verification_failed "$1"
        printf '%s\t%s\n' "${id}" "${started}"
    }

    # A moving source policy can require session discovery. An exact committed
    # definition still takes precedence when the caller passes LATEST.
    if [[ ${expected_version} == LATEST && ${MINECRAFT_VERSION} != LATEST ]]; then
        expected_version="${MINECRAFT_VERSION}"
    fi
    container_session="$(inspect_running_session 41)" || exit "$?"
    IFS=$'\t' read -r container_id session_start <<< "${container_session}"
    probe_container="${container_id}"
    # Container logs are tied to this start, unlike latest.log inside a copied world.
    session_log="$(podman logs --since "${session_start}" --tail 4096 "${container_id}" 2>&1 | tail -c 1048576)" || verification_failed 44
    if [[ ${expected_version} == LATEST ]]; then
        expected_version="$(sed -nE 's/.*Starting minecraft server version ([0-9][0-9A-Za-z._+-]*)([[:space:]]*)$/\1/p' <<< "${session_log}" | tail -n 1)"
        [[ -n ${expected_version} ]] || verification_failed 44
    fi
    grep -Eq 'Done \([0-9.]+s\)! For help' <<< "${session_log}" || {
        verification_failed 44 'ERROR: This Minecraft session did not provide world startup evidence.'
    }
    if [[ -n ${JV_INSTANCE_IMAGE_DIGEST:-} ]]; then
        image_id="$(podman inspect "${container_id}" --format '{{.Image}}')" || verification_failed 45
        [[ $(podman image inspect "${image_id}" --format '{{.Digest}}') == "${JV_INSTANCE_IMAGE_DIGEST}" ]] || verification_failed 45
    fi
    if [[ ${MINECRAFT_SERVER_TYPE} == pufferfish ]]; then
        build="$(jq -er '.runtime.pufferfish_build // 0 | select(type == "number" and . >= 0)' "/etc/justvoxel/instances/${JV_INSTANCE_ID}/config.json")" || verification_failed 40
        # A deployed source can predate build pinning. New Switch targets
        # require a build pin during review and runtime publication.
        if (( build > 0 )); then
            [[ $(podman inspect "${container_id}" --format '{{range .Config.Env}}{{println .}}{{end}}' | grep '^PUFFERFISH_BUILD=') == "PUFFERFISH_BUILD=${build}" ]] || verification_failed 48
        fi
    fi
    if [[ ${BEDROCK_ENABLED} == yes ]]; then
        # Confirm a real UDP listener in the isolated runtime network namespace.
        podman exec "${container_id}" sh -c 'awk "\$2 ~ /:4ABC\$/ {found=1} END {exit !found}" /proc/net/udp /proc/net/udp6' || {
            verification_failed 50 'ERROR: The managed cross-play listener is not active.'
        }
    fi
    verify_session_unchanged() {
        local current
        current="$(inspect_running_session 43)" || exit "$?"
        [[ ${current} == "${container_session}" ]] || verification_failed 43
    }
else
    verify_session_unchanged() { :; }
fi

if [[ ${MINECRAFT_SERVER_TYPE-paper} == vanilla ]]; then
    status="$(podman exec "${probe_container}" mc-monitor status --json)" || { verification_failed 46 'ERROR: Minecraft status probe failed.'; }
    actual="$(jq -er '.server_info.version.name | select(type == "string" and length > 0)' <<< "${status}")" || { verification_failed 46 'ERROR: Minecraft status version is invalid.'; }
    [[ ${expected_version} == LATEST || ${actual} == "${expected_version}" ]] || { verification_failed 47 'ERROR: Minecraft is not running the selected game version.'; }
    podman exec "${probe_container}" rcon-cli list >/dev/null || { verification_failed 49 'ERROR: Minecraft RCON check failed.'; }
    printf 'Minecraft version: %s\n' "${actual}"
    verify_session_unchanged
    exit 0
fi
# New Java types have no managed-plugin verification. Verify the selected game
# and the native implementation before accepting readiness; never probe Bukkit
# commands on a mod loader or silently accept another loader.
case "${MINECRAFT_SERVER_TYPE-paper}" in
    spigot)
        version="$(podman exec "${probe_container}" rcon-cli version)" || verification_failed 49
        [[ ${version} == *'Spigot-'* ]] || verification_failed 48 'ERROR: the selected Spigot software could not be verified.'
        [[ ${version} == *"(MC: ${expected_version})"* ]] || verification_failed 47 'ERROR: the selected Spigot game version could not be verified.'
        podman exec "${probe_container}" rcon-cli list >/dev/null || verification_failed 49
        printf 'Minecraft version: %s\n' "${version}"
        if [[ ${BEDROCK_ENABLED} != yes ]]; then
            verify_session_unchanged
            exit 0
        fi
        ;;
    forge|neoforge|fabric|quilt)
        [[ ${expected_version} != LATEST && -n ${MINECRAFT_LOADER_VERSION:-} ]] || {
            verification_failed 48 'ERROR: the configured mod loader version could not be verified.'
        }
        # RCON can be ready before a restarted mod loader serves status. At most
        # eight five-second probes and seven two-second sleeps (54 seconds).
        status_ready=no
        for ((status_attempt=1; status_attempt<=8; status_attempt++)); do
            if status="$(podman exec "${probe_container}" mc-monitor status --timeout 5s --json 2>/dev/null)"; then
                status_ready=yes
                break
            fi
            if (( status_attempt < 8 )); then sleep 2; fi
        done
        [[ ${status_ready} == yes ]] || {
            verification_failed 46 'ERROR: Minecraft status probe did not become ready after RCON.'
        }
        actual="$(jq -er '.server_info.version.name | select(type == "string" and length > 0)' <<< "${status}" 2>/dev/null)" || {
            verification_failed 46 'ERROR: Minecraft status version is invalid or missing.'
        }
        case "${actual}" in
            "${expected_version}"|"${expected_version} "*|*" ${expected_version}") ;;
            *) verification_failed 47 'ERROR: the selected Minecraft game version could not be verified.' ;;
        esac
        case "${MINECRAFT_SERVER_TYPE-paper}" in
            fabric) marker="Loading Minecraft ${expected_version} with Fabric Loader ${MINECRAFT_LOADER_VERSION}" ;;
            quilt) marker="Loading Minecraft ${expected_version} with Quilt Loader ${MINECRAFT_LOADER_VERSION}" ;;
            forge) marker="Forge mod loading, version ${MINECRAFT_LOADER_VERSION}, for MC ${expected_version}" ;;
            neoforge) marker="NeoForge mod loading, version ${MINECRAFT_LOADER_VERSION}, for MC ${expected_version}" ;;
        esac
        # Compare complete version tokens, not prefixes (e.g. 0.16.1 vs 0.16.10).
        if [[ ${switch_verification} == yes ]]; then
            loader_log() { printf '%s\n' "${session_log}"; }
        else
            loader_log() { cat -- "${DATA_PATH}/logs/latest.log"; }
        fi
        loader_log | awk -v marker="${marker}" '
            index($0, marker) {
                tail = substr($0, index($0, marker) + length(marker))
                if (tail == "" || tail ~ /^[[:space:],]/) found = 1
            }
            END { exit !found }
        ' || {
            verification_failed 48 'ERROR: the selected mod loader could not be verified in the current server log.'
        }
        podman exec "${probe_container}" rcon-cli list >/dev/null || {
            verification_failed 49 'ERROR: Minecraft final RCON check failed.'
        }
        if [[ ${BEDROCK_ENABLED} == yes ]]; then
            [[ ${MINECRAFT_SERVER_TYPE} == fabric || ${MINECRAFT_SERVER_TYPE} == neoforge ]] || {
                verification_failed 50 'ERROR: managed cross-play mod ownership could not be verified.'
            }
            [[ -n ${JV_INSTANCE_ID:-} ]] || {
                verification_failed 50 'ERROR: managed cross-play mod ownership could not be verified.'
            }
            /usr/libexec/justvoxel/mjust/managed-crossplay-mod-ownership verify "${MINECRAFT_SERVER_TYPE}" "${DATA_PATH}" "/etc/justvoxel/instances/${JV_INSTANCE_ID}/crossplay-mods.json" '' || {
                verification_failed 50 'ERROR: managed cross-play mod ownership could not be verified.'
            }
            if [[ ${switch_verification} == yes ]]; then
                ownership="/etc/justvoxel/instances/${JV_INSTANCE_ID}/crossplay-mods.json"
                count=2
                [[ ${MINECRAFT_SERVER_TYPE} != fabric ]] || count=3
                jq -e --argjson count "${count}" '.artifacts | length == $count' "${ownership}" >/dev/null || verification_failed 50
            fi
            # Geyser's mod command source logs responses for non-player senders.
            podman exec "${probe_container}" rcon-cli 'geyser version' >/dev/null || {
                verification_failed 50 'ERROR: Geyser version query failed.'
            }
            platform_name=Geyser-Fabric
            [[ ${MINECRAFT_SERVER_TYPE} != neoforge ]] || platform_name=Geyser-NeoForge
            grep -Eq '^[[:space:]]*auth-type:[[:space:]]*floodgate[[:space:]]*(#.*)?$' "${DATA_PATH}/config/${platform_name}/config.yml" || {
                verification_failed 50 'ERROR: Geyser Floodgate authentication could not be verified.'
            }
        fi
        printf 'Minecraft version: %s (%s %s)\n' "${expected_version}" "${MINECRAFT_SERVER_TYPE}" "${MINECRAFT_LOADER_VERSION}"
        verify_session_unchanged
        exit 0
        ;;
esac
if [[ ${MINECRAFT_SERVER_TYPE-paper} != spigot ]]; then
# Paper/Purpur can expose RCON before their asynchronous version check completes.
# Retry only that exact readiness response; completed software/version checks stay strict.
# After the same bounded wait, local status can verify the running software and game version.
version_wait=0
while :; do
    version="$(podman exec "${probe_container}" rcon-cli version)" || verification_failed 49
    # Normalize terminal presentation only; keep the raw completed response for validation.
    comparison_version="$(printf '%s' "${version}" | sed $'s/\033\\[[0-9;]*m//g')"
    comparison_version="${comparison_version//$'\r'/}"
    comparison_version="${comparison_version#"${comparison_version%%[![:space:]]*}"}"
    comparison_version="${comparison_version%"${comparison_version##*[![:space:]]}"}"
    [[ ${comparison_version} == 'Checking version, please wait...' ]] || break
    if (( version_wait >= 60 )); then
        [[ ${MINECRAFT_SERVER_TYPE-paper} == paper || ${MINECRAFT_SERVER_TYPE-paper} == purpur || ${MINECRAFT_SERVER_TYPE-paper} == pufferfish || ${MINECRAFT_SERVER_TYPE-paper} == leaf ]] || { verification_failed 48 'ERROR: Minecraft server software cannot use the local version fallback.'; }
        status="$(podman exec "${probe_container}" mc-monitor status --json)" || { verification_failed 46 'ERROR: Minecraft status probe failed.'; }
        actual="$(jq -er '.server_info.version.name | select(type == "string" and length > 0) | select(contains("\n") | not)' <<< "${status}")" || { verification_failed 46 'ERROR: Minecraft status version is invalid.'; }
        [[ ${actual} =~ ^(Paper|Purpur|Pufferfish|Leaf)\ ([0-9A-Za-z._-]+)$ ]] || { verification_failed 46 'ERROR: Minecraft status version is invalid.'; }
        actual_software="${BASH_REMATCH[1]}"
        actual_version="${BASH_REMATCH[2]}"
        [[ ${actual_software,,} == "${MINECRAFT_SERVER_TYPE-paper}" ]] || { verification_failed 48 'ERROR: Minecraft is not running the selected server software.'; }
        [[ ${expected_version} == LATEST || ${actual_version} == "${expected_version}" ]] || { verification_failed 47 'ERROR: Minecraft is not running the selected game version.'; }
        printf 'Minecraft version (local status): %s\n' "${actual}"
        break
    fi
    sleep 3
    version_wait=$((version_wait + 3))
done
# Only the exact transient response may use the local status fallback above.
if [[ ${comparison_version} != 'Checking version, please wait...' ]]; then
    printf 'Minecraft version: %s\n' "${version}"
    if [[ ${switch_verification} == yes ]]; then
        # Bind the version to the software banner, before any update notices.
        # Paper-family implementations include either an MC marker or a build
        # identifier prefixed with the exact game version.
        banner="${comparison_version%%$'\n'*}"
        software="${MINECRAFT_SERVER_TYPE^}"
        case "${banner}" in
            "This server is running ${software} "*) ;;
            *) verification_failed 48 'ERROR: Minecraft is not running the selected server software.' ;;
        esac
        if [[ ${banner} == *'MC: '* ]]; then
            [[ ${banner} == *"(MC: ${expected_version})"* ]] || verification_failed 47
        else
            release="This server is running ${software} version ${expected_version}"
            case "${banner}" in
                "${release}"|"${release}-"*|"${release} "*) ;;
                *) verification_failed 47 'ERROR: Minecraft is not running the selected game version.' ;;
            esac
        fi
    else
        [[ ${version,,} == *"${MINECRAFT_SERVER_TYPE-paper}"* ]] || { verification_failed 48 'ERROR: Minecraft is not running the selected server software.'; }
        [[ ${version} == *'MC: '* || ${version} == *'Minecraft version '* || ${version} == *'Paper version '* || ${version} == *'Purpur version '* || ${version} == *'Pufferfish version '* || ${version} == *'Leaf version '* ]] || { verification_failed 48 'ERROR: Minecraft version response could not be verified.'; }
        if [[ ${expected_version} != LATEST ]]; then
            [[ ${expected_version} =~ ^[0-9A-Za-z._-]+$ ]] || exit 1
            [[ ${version} == *"MC: ${expected_version})"* || ${version} == *"Minecraft version ${expected_version} "* ||
               ${version} == *"Paper version ${expected_version}-"* || ${version} == *"Paper version ${expected_version} "* || ${version} == *"Purpur version ${expected_version}-"* || ${version} == *"Purpur version ${expected_version} "* ]] || {
                verification_failed 47 'ERROR: Minecraft is not running the selected game version.'
            }
        fi
    fi
fi
fi
if [[ ${runtime_only} == yes ]]; then
    podman exec "${probe_container}" rcon-cli list >/dev/null || verification_failed 49
    verify_session_unchanged
    exit 0
fi
plugins="$(podman exec "${probe_container}" rcon-cli plugins)" || verification_failed 49
printf 'Plugins: %s\n' "${plugins}"
[[ ${plugins} == *ViaVersion* && ${plugins} != *§cViaVersion* ]] || { verification_failed 50 'ERROR: ViaVersion could not be verified.'; }
if [[ ${JV_NETWORK_MEMBER:-no} == yes && ( ${MINECRAFT_SERVER_TYPE-paper} == paper || ${MINECRAFT_SERVER_TYPE-paper} == purpur ) ]]; then
    [[ ${plugins,,} == *floodgate* && ${plugins,,} != *§cfloodgate* ]] || { echo 'ERROR: Network Floodgate could not be verified.' >&2; exit 1; }
    [[ ${plugins,,} != *geyser* ]] || { echo 'ERROR: Backend Geyser must be absent while enrolled in Minecraft Network.' >&2; exit 1; }
elif [[ ${BEDROCK_ENABLED} == yes ]]; then
    [[ ${plugins} == *Geyser* && ${plugins,,} == *floodgate* && ${plugins} != *§cGeyser* && ${plugins,,} != *§cfloodgate* ]] || { verification_failed 50 'ERROR: Cross-play plugins could not be verified.'; }
    geyser="$(podman exec "${probe_container}" rcon-cli 'geyser version')" || verification_failed 50
    printf 'Geyser: %s\n' "${geyser}"
    [[ ${content_install} == yes || ( ${geyser} == *Geyser* && ${geyser,,} == *version* && ${geyser,,} != *'unknown command'* ) ]] || {
        verification_failed 50 'ERROR: Geyser version response could not be verified.'
    }
    grep -Eq '^[[:space:]]*auth-type:[[:space:]]*floodgate[[:space:]]*(#.*)?$' "${DATA_PATH}/plugins/Geyser-Spigot/config.yml" || {
        verification_failed 50 'ERROR: Geyser Floodgate authentication could not be verified.'
    }
fi
verify_session_unchanged
