#!/usr/bin/bash
set -Eeuo pipefail
umask 0077
fail() { echo 'ERROR: instance backup prerequisite or storage operation failed.' >&2; exit 1; }
[[ $EUID == 0 && ( $# == 2 || ( $# == 3 && ( $1 == create || $1 == matrix-* ) ) ) && $2 =~ ^jv-[a-z0-9]{6,12}$ ]] || fail
action=$1 id=$2
if [[ ${action} == run ]]; then
    # Local root peer authentication; no token, cookie, or runtime secret.
    exec curl --silent --show-error --fail --max-time 21000 \
        --unix-socket /run/justvoxel/management.sock \
        --header 'Content-Type: application/json' --data '{}' \
        "http://localhost/v1/minecraft/instances/${id}/backups/run"
fi
case ${action} in inventory|preflight|create|retain|matrix-prepare|matrix-bind|matrix-absent|matrix-inventory|matrix-check|matrix-retire|matrix-placement) ;; *) fail ;; esac
source /usr/libexec/justvoxel/mjust/backup-common.sh
# Matrix absence checks use the reservation receipt when no committed runtime
# exists. All other actions still require the committed runtime.
if [[ ${action} != matrix-absent ]]; then
    /usr/libexec/justvoxel/mjust/validate-instance-runtime-commit "${id}" >/dev/null 2>&1 || fail
fi
if [[ ${action} == matrix-* ]]; then
    [[ ${3:-} =~ ^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$ ]] || fail
    receipt="/var/lib/justvoxel-instance-runtime/matrix-$3-${id}.json"
    [[ -f ${receipt} && ! -L ${receipt} && $(stat -c '%u:%g:%a' -- "${receipt}") == 0:0:600 ]] || fail
    mapfile -t placement < <(jq -er '.placement | [.root,.path,.mount_point,.uuid,.source] | .[]' "${receipt}")
    [[ ${#placement[@]} == 5 && ${placement[1]} == "${placement[0]}/${id}" ]] || fail
    minecraft_backup_path=${placement[0]} BACKUP_MOUNT_POINT=${placement[2]}
    BACKUP_EXPECTED_UUID=${placement[3]} BACKUP_EXPECTED_SOURCE=${placement[4]}
    [[ ${minecraft_backup_path} =~ ^/[A-Za-z0-9_./-]+$ && ${minecraft_backup_path} != / &&
        $(realpath -e -- "${minecraft_backup_path}") == "${minecraft_backup_path}" ]] || fail
    case "${minecraft_backup_path}" in /etc|/etc/*|/usr|/usr/*|/boot|/boot/*|/proc|/proc/*|/sys|/sys/*|/dev|/dev/*|/run|/run/*) fail ;; esac
    if [[ -n ${BACKUP_MOUNT_POINT} ]]; then
        [[ $(realpath -e -- "${BACKUP_MOUNT_POINT}") == "${BACKUP_MOUNT_POINT}" &&
            ( -n ${BACKUP_EXPECTED_UUID} || -n ${BACKUP_EXPECTED_SOURCE} ) ]] || fail
    else
        [[ -z ${BACKUP_EXPECTED_UUID} && -z ${BACKUP_EXPECTED_SOURCE} ]] || fail
    fi
    jv_backup_require_read_target >/dev/null 2>&1 || fail
    export JV_INSTANCE_BACKUP_ROOT="${minecraft_backup_path}"
else
    jv_instance_backup_load_target "${id}" || fail
fi
if [[ ${action} != inventory && ${action} != matrix-absent ]]; then
    mapfile -t fields < <(jq -er '[.runtime.id,.storage.root,.storage.data_path,.storage.mount_point,.storage.uuid,.storage.source,(.runtime.uid|tostring),(.runtime.gid|tostring)] | .[]' "/etc/justvoxel/instances/${id}/config.json")
    [[ ${#fields[@]} == 8 && ${fields[0]} == "${id}" ]] || fail
    /usr/libexec/justvoxel/mjust/instance-runtime-prerequisites validate "${fields[@]}" >/dev/null 2>&1 || fail
fi
python3 - "${action}" "${id}" "${3:-}" <<'PY'
import ctypes, datetime, errno, gzip, hashlib, json, os, re, secrets, stat, sys, tarfile, unicodedata

action, identity, creation_name = sys.argv[1:]
root = os.environ['JV_INSTANCE_BACKUP_ROOT']
config_root = '/etc/justvoxel/instances'
registry = '/var/lib/justvoxel/instances'
archive_pattern = re.compile(r'(?P<name>.{1,64})-backup-(?P<software>[a-z][a-z0-9-]{0,70})-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4}(-[1-9][0-9]{0,2})?\.tar\.gz')

def valid_backup_name(name):
    return (isinstance(name, str) and 1 <= len(name) <= 64 and name == name.strip()
            and name not in ('.', '..') and all(unicodedata.category(c)[0] in 'LNM' or c in " ._-'()" for c in name))

def valid_archive(filename):
    match = archive_pattern.fullmatch(filename)
    return bool(match and len(filename.encode('utf-8')) <= 245 and valid_backup_name(match['name']))

sha_pattern = re.compile(r'^[a-f0-9]{64}$')
metadata_keys = {'schema','id','name','software','version','created','archive','size','configuration_sha256','sha256'}

def open_dir(path):
    if not path.startswith('/') or os.path.normpath(path) != path:
        raise ValueError('path')
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    try:
        for component in path.split('/')[1:]:
            nxt = os.open(component, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            os.close(fd)
            fd = nxt
        return fd
    except BaseException:
        os.close(fd)
        raise

def read_at(fd, name, limit=16384):
    f = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
    with os.fdopen(f, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
            raise ValueError('file')
        raw = stream.read(limit + 1)
        if len(raw) > limit:
            raise ValueError('size')
        return raw

def private(path, limit=65536, root_group=True):
    fd = open_dir(os.path.dirname(path))
    try:
        info = os.stat(os.path.basename(path), dir_fd=fd, follow_symlinks=False)
        if info.st_uid != 0 or (root_group and info.st_gid != 0) or stat.S_IMODE(info.st_mode) != 0o600:
            raise ValueError('private')
        return read_at(fd, os.path.basename(path), limit)
    finally:
        os.close(fd)

def validate_meta(fd, filename):
    if not valid_archive(filename):
        raise ValueError('name')
    m = json.loads(read_at(fd, filename + '.meta.json'))
    if not isinstance(m,dict):
        raise ValueError('metadata')
    expected_keys = metadata_keys | ({'loader_version'} if m.get('software') in ('forge','neoforge','fabric','quilt') else set())
    if m.get('software') == 'pufferfish' and 'pufferfish_build' in m:
        if type(m['pufferfish_build']) != int or m['pufferfish_build'] <= 0:
            raise ValueError('pufferfish build')
        expected_keys.add('pufferfish_build')
    if set(m) != expected_keys or type(m['schema']) != int or m['schema'] != 1 or m['id'] != identity or m['archive'] != filename:
        raise ValueError('identity')
    if m['software'] not in ('paper','purpur','pufferfish','leaf','vanilla','spigot','forge','neoforge','fabric','quilt','bedrock') or not isinstance(m['version'],str) or len(m['version']) > 64:
        raise ValueError('software')
    if 'loader_version' in expected_keys and (not isinstance(m['loader_version'],str) or not re.fullmatch(r'[0-9]+(?:\.[0-9]+){1,3}(?:-[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)*)?',m['loader_version']) or len(m['loader_version']) > 64):
        raise ValueError('loader')
    if not isinstance(m['name'],str) or len(m['name']) > 64 or any(ord(c)<32 for c in m['name']):
        raise ValueError('description')
    match = archive_pattern.fullmatch(filename)
    if match['software'] != m['software'] or (match['name'] != 'instance' and match['name'] != m['name']):
        raise ValueError('archive metadata binding')
    if not isinstance(m['created'],str) or len(m['created']) != 20:
        raise ValueError('created')
    datetime.datetime.strptime(m['created'], '%Y-%m-%dT%H:%M:%SZ')
    if not sha_pattern.fullmatch(m['sha256']) or not sha_pattern.fullmatch(m['configuration_sha256']):
        raise ValueError('hash')
    info = os.stat(filename, dir_fd=fd, follow_symlinks=False)
    if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or type(m['size']) != int or info.st_size != m['size'] or m['size'] <= 0:
        raise ValueError('archive')
    return m

def inventory(fd):
    result = []
    entries = os.listdir(fd)
    if len(entries) > 10000:
        raise ValueError('inventory bound')
    for filename in entries:
        if not valid_archive(filename):
            continue
        try:
            result.append(validate_meta(fd, filename))
        except (ValueError, OSError, KeyError, TypeError):
            continue # Incomplete, foreign, or unrecognized files are never owned.
    return sorted(result, key=lambda m:(m['created'],m['archive']), reverse=True)

def sync_dir(fd):
    os.fsync(fd)

def write_new(fd, name, data):
    f = os.open(name, os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW, 0o600, dir_fd=fd)
    with os.fdopen(f,'wb') as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())

def storage_identity(fd):
    info = os.fstat(fd)
    return [info.st_dev, info.st_ino]

def mount_id(fd):
    with open(f'/proc/self/fdinfo/{fd}') as stream:
        return next(line for line in stream if line.startswith('mnt_id:')).split()[1]

def file_proof(fd, name):
    f = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=fd)
    with os.fdopen(f, 'rb') as stream:
        info = os.fstat(stream.fileno())
        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size <= 0 or mount_id(f) != mount_id(fd):
            raise ValueError('unsafe backup retirement file')
        digest = hashlib.file_digest(stream, 'sha256').hexdigest()
        after = os.fstat(stream.fileno())
        if (info.st_size, info.st_ctime_ns, info.st_mtime_ns) != (after.st_size, after.st_ctime_ns, after.st_mtime_ns):
            raise ValueError('backup retirement file changed')
        return {'inode':[info.st_dev, info.st_ino], 'size':info.st_size, 'sha256':digest}

def missing_at(fd, name):
    try:
        os.stat(name, dir_fd=fd, follow_symlinks=False)
    except FileNotFoundError:
        return True
    return False

def matrix_backup_directory(root_fd, name):
    fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=root_fd)
    info = os.fstat(fd)
    if mount_id(fd) != mount_id(root_fd) or info.st_uid != 0 or stat.S_IMODE(info.st_mode) != 0o700:
        os.close(fd)
        raise ValueError('backup directory identity')
    return fd

def matrix_backup_storage(root_fd):
    # The Agent holds the persistent matrix reservation and uses only a
    # fixture's verified committed placement. Refuse substituted directories.
    parent_id = creation_name
    if not re.fullmatch(r'[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}', parent_id):
        raise ValueError('matrix operation identity')
    parent = json.loads(private('/var/lib/justvoxel/management/logs/operations/' + parent_id + '.json', 1024 * 1024, root_group=False))
    fixture = json.loads(private('/var/lib/justvoxel-instance-runtime/matrix-' + parent_id + '-' + identity + '.json', 1024 * 1024))
    phase = parent['stage']
    active = parent['state'] == 'running'
    interrupted = parent['state'] == 'needs_attention'
    retirement = active and phase == 'retirement' or interrupted
    binding = active and phase in ('fixtures', 'switch') or interrupted
    allowed = (action == 'matrix-prepare' and binding and fixture['stage'] == 'binding' or
               action == 'matrix-bind' and binding and fixture['stage'] == 'binding' or
               action == 'matrix-absent' and retirement and fixture['stage'] in ('reserved', 'binding', 'intent') or
               action == 'matrix-inventory' and (active and phase == 'switch' or retirement) and fixture['stage'] == 'owned' or
               action == 'matrix-placement' and interrupted and fixture['stage'] == 'owned' or
               action == 'matrix-check' and retirement and fixture['stage'] in ('binding', 'intent') or
               action == 'matrix-retire' and retirement and fixture['stage'] == 'intent')
    if not allowed or parent['operation_id'] != parent_id or parent['operation_type'] != 'switch_matrix' or identity not in parent['matrix_fixtures']:
        raise ValueError('matrix operation ownership')
    if (fixture['parent'] != parent_id or fixture['id'] != identity or
            fixture['placement']['root'] != root or fixture['placement']['path'] != root + '/' + identity):
        raise ValueError('matrix fixture ownership')
    staged = '.matrix-' + parent_id + '-' + identity
    expected = fixture['backups']
    root_identity = storage_identity(root_fd)
    if action == 'matrix-absent':
        if (expected['directory'] != [0, 0] or expected['root'] != [0, 0] or
                not missing_at(root_fd, identity) or not missing_at(root_fd, staged)):
            raise ValueError('unverified backup namespace')
        sync_dir(root_fd)
        return
    if fixture['placement'] != record.get('backups') or fixture['storage'] != record['storage']:
        raise ValueError('matrix fixture placement changed')
    # Recovery uses this read-only check before restoring the exact config hash.
    if action != 'matrix-placement' and fixture['config_sha256'] != hashlib.sha256(record_raw).hexdigest():
        raise ValueError('matrix fixture configuration changed')
    if action == 'matrix-retire':
        try:
            restore = json.loads(private(config_root + '/' + identity + '/restore-journal.json'))
        except FileNotFoundError:
            pass
        else:
            if restore['id'] != identity or restore['stage'] not in ('completed', 'rolled_back'):
                raise ValueError('restore is unresolved')
    if action == 'matrix-prepare':
        if expected['directory'] != [0, 0] or expected['root'] != [0, 0] or not missing_at(root_fd, identity):
            raise ValueError('backup namespace already exists')
        os.mkdir(staged, 0o700, dir_fd=root_fd)
        fd = matrix_backup_directory(root_fd, staged)
        try:
            sync_dir(fd)
            sync_dir(root_fd)
            print(json.dumps({'root':root_identity, 'directory':storage_identity(fd), 'files':{}}))
        finally:
            os.close(fd)
        return
    if expected['root'] != root_identity:
        raise ValueError('backup root identity')
    if action == 'matrix-bind':
        pending = not missing_at(root_fd, staged)
        fd = matrix_backup_directory(root_fd, staged if pending else identity)
        try:
            with os.scandir(fd) as reader:
                if storage_identity(fd) != expected['directory'] or next(reader, None) is not None:
                    raise ValueError('unverified prepared backup directory')
            if pending:
                libc = ctypes.CDLL(None, use_errno=True)
                # Publish the exact staged inode without replacing a foreign name.
                if libc.renameat2(root_fd, os.fsencode(staged), root_fd, os.fsencode(identity), 1) != 0:
                    raise OSError(ctypes.get_errno(), 'backup namespace publication')
            current = os.stat(identity, dir_fd=root_fd, follow_symlinks=False)
            if [current.st_dev, current.st_ino] != expected['directory']:
                raise ValueError('published backup directory changed')
        finally:
            os.close(fd)
        sync_dir(root_fd)
        return
    namespace = identity
    if not missing_at(root_fd, staged):
        if action in ('matrix-inventory', 'matrix-placement') or not missing_at(root_fd, identity):
            raise ValueError('multiple backup namespaces')
        namespace = staged
    try:
        fd = matrix_backup_directory(root_fd, namespace)
    except FileNotFoundError:
        if action in ('matrix-check', 'matrix-retire'):
            if action == 'matrix-retire':
                sync_dir(root_fd)
            return
        raise
    try:
        directory = storage_identity(fd)
        if expected['directory'] != directory:
            raise ValueError('backup directory replaced')
        if action == 'matrix-placement':
            return
        info = os.fstat(fd)
        with os.scandir(fd) as reader:
            entries = []
            for entry in reader:
                if len(entries) >= 256:
                    raise ValueError('backup retirement bound')
                entries.append(entry.name)
        files = {}
        if action == 'matrix-inventory':
            for filename in entries:
                if filename.endswith('.meta.json'):
                    continue
                metadata = validate_meta(fd, filename)
                files[filename] = file_proof(fd, filename)
                if files[filename]['sha256'] != metadata['sha256'] or files[filename]['size'] != metadata['size']:
                    raise ValueError('archive checksum')
                sidecar = filename + '.meta.json'
                files[sidecar] = file_proof(fd, sidecar)
                if validate_meta(fd, filename) != metadata:
                    raise ValueError('archive metadata changed')
            if set(entries) != set(files):
                raise ValueError('unexpected backup file')
            print(json.dumps({'root':root_identity, 'directory':directory, 'files':files}))
            return
        # Missing entries are allowed on retry, but only after the full exact
        # inventory was saved as retirement intent by the Agent.
        for filename in entries:
            if filename not in expected['files'] or file_proof(fd, filename) != expected['files'][filename]:
                raise ValueError('backup retirement file replaced')
        if action == 'matrix-check':
            return
        for filename in entries:
            if file_proof(fd, filename) != expected['files'][filename]:
                raise ValueError('backup retirement file changed')
            os.unlink(filename, dir_fd=fd)
        sync_dir(fd)
        current = os.stat(namespace, dir_fd=root_fd, follow_symlinks=False)
        if (current.st_dev, current.st_ino) != (info.st_dev, info.st_ino):
            raise ValueError('backup retirement directory changed')
        os.rmdir(namespace, dir_fd=root_fd)
        sync_dir(root_fd)
    finally:
        os.close(fd)

try:
    if action == 'matrix-absent':
        root_fd = open_dir(root)
        try:
            matrix_backup_storage(root_fd)
        finally:
            os.close(root_fd)
        raise SystemExit(0)
    record_raw = private(config_root + '/' + identity + '/config.json')
    record = json.loads(record_raw)
    if action.startswith('matrix-') and 'backups' not in record:
        raise ValueError('backup placement unavailable')
    if 'backups' in record and (record['backups']['root'] != root or record['backups']['path'] != root + '/' + identity):
        raise ValueError('backup placement changed')
    if json.loads(private(registry + '/' + identity + '.json')) != {'id':identity} or record['runtime']['id'] != identity:
        raise ValueError('identity')
    source = record['storage']['data_path']
    if source != record['storage']['root'] + '/minecraft-instances/' + identity + '/data':
        raise ValueError('source')
    if root == source or root.startswith(source + '/') or source.startswith(root + '/'):
        raise ValueError('overlap')
    root_fd = open_dir(root)
    fd = None
    try:
        if action.startswith('matrix-'):
            matrix_backup_storage(root_fd)
            raise SystemExit(0)
        if action != 'inventory':
            try:
                os.mkdir(identity, 0o700, dir_fd=root_fd)
                sync_dir(root_fd)
            except FileExistsError:
                pass
        try:
            fd = os.open(identity, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=root_fd)
        except FileNotFoundError:
            if action == 'inventory':
                print('[]')
                raise SystemExit(0)
            raise
        # No path substitutions after destination validation: operate on fd.
        os.fchdir(fd)
        if action == 'inventory':
            print(json.dumps(inventory(fd), separators=(',',':')))
        elif action == 'retain':
            settings = json.loads(private(config_root + '/' + identity + '/backup-settings.json'))
            keep = settings['retention']
            if type(keep) != int or not 1 <= keep <= 365:
                raise ValueError('retention')
            # Live Restore holds the shared operation claims. Also protect its
            # selection after process death, before administrator recovery.
            pinned = None
            try:
                journal = json.loads(private(config_root + '/' + identity + '/restore-journal.json'))
            except FileNotFoundError:
                pass
            else:
                if journal['schema'] != 1 or journal['id'] != identity or not valid_archive(journal['archive']):
                    raise ValueError('restore journal')
                if journal['stage'] not in ('completed','rolled_back'):
                    pinned = journal['archive']
            for m in inventory(fd)[keep:]:
                filename = m['archive']
                if filename == pinned:
                    continue
                # Recheck ownership just before deletion; never glob-delete.
                if validate_meta(fd, filename) != m:
                    raise ValueError('changed metadata')
                os.unlink(filename, dir_fd=fd)
                os.unlink(filename + '.meta.json', dir_fd=fd)
            sync_dir(fd)
        else:
            # Space check is intentionally conservative: no compression assumed,
            # plus tar headers, long names and 64 MiB working margin.
            source_fd = open_dir(source)
            os.close(source_fd)
            size = 64 * 1024 * 1024
            def traversal_error(error):
                raise error
            for parent, dirs, files in os.walk(source, followlinks=False, onerror=traversal_error):
                for name in dirs + files:
                    info = os.lstat(os.path.join(parent,name))
                    if not (stat.S_ISDIR(info.st_mode) or stat.S_ISREG(info.st_mode)):
                        raise ValueError('source links or special files')
                    size += (info.st_size if stat.S_ISREG(info.st_mode) else 0) + 8192 + len(name.encode()) * 4
            space = os.fstatvfs(fd)
            if space.f_bavail * space.f_frsize < size:
                raise ValueError('capacity')
            if action == 'preflight':
                probe = '.instance-backup-probe-' + secrets.token_hex(12)
                # Cleanup is authorized only after our exclusive creation.
                write_new(fd,probe,b'')
                os.unlink(probe,dir_fd=fd)
            else:
                # Only our unique temporary files are cleaned. Stale files from
                # SIGKILL/power loss stay unadvertised and are never glob-deleted.
                tmp = '.instance-backup-' + secrets.token_hex(12)
                meta_tmp = tmp + '.meta'
                owned = set()
                try:
                    software = record['runtime']['software']
                    if software not in ('paper','purpur','pufferfish','leaf','vanilla','spigot','forge','neoforge','fabric','quilt','bedrock'):
                        raise ValueError('software')
                    now = datetime.datetime.now(datetime.timezone.utc)
                    name = creation_name
                    if not name:
                        presentation = json.loads(private(registry + '/names/' + identity + '.json'))
                        if presentation['id'] != identity:
                            raise ValueError('name identity')
                        name = presentation['display_name']
                    if not valid_backup_name(name):
                        raise ValueError('name')
                    base = name + '-backup-' + software + '-' + now.strftime('%Y-%m-%d-%H%M')
                    filename = None
                    for suffix in [''] + ['-' + str(n) for n in range(2,1000)]:
                        candidate = base + suffix + '.tar.gz'
                        if not valid_archive(candidate):
                            raise ValueError('archive name length')
                        if not os.path.lexists(candidate) and not os.path.lexists(candidate + '.meta.json'):
                            filename = candidate
                            break
                    if filename is None:
                        raise ValueError('collisions')
                    f = os.open(tmp,os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW,0o600,dir_fd=fd)
                    owned.add(tmp)
                    with os.fdopen(f,'wb') as stream:
                        with tarfile.open(fileobj=stream,mode='w:gz',dereference=False) as archive:
                            def safe_member(member):
                                if not (member.isfile() or member.isdir()) or member.islnk() or member.issym():
                                    raise ValueError('source changed or unsupported entry')
                                return member
                            archive.add(source,arcname='data',filter=safe_member)
                        stream.flush()
                        os.fsync(stream.fileno())
                    # Consume gzip to EOF to validate CRC/trailer, then validate
                    # every tar member. No extraction and no ID inside the world.
                    with gzip.open(tmp,'rb') as stream:
                        while stream.read(1024*1024): pass
                    members = 0
                    with tarfile.open(tmp,'r:gz') as archive:
                        for member in archive:
                            path = member.name
                            if not (path == 'data' or path.startswith('data/')) or '..' in path.split('/') or not (member.isfile() or member.isdir()) or member.islnk() or member.issym():
                                raise ValueError('archive integrity')
                            members += 1
                    if not members:
                        raise ValueError('empty archive')
                    digest = hashlib.sha256()
                    with open(tmp,'rb') as stream:
                        while block := stream.read(1024*1024): digest.update(block)
                    m = dict(schema=1,id=identity,name=name,software=software,version=record['runtime']['version'],
                             created=now.strftime('%Y-%m-%dT%H:%M:%SZ'),archive=filename,size=os.stat(tmp).st_size,
                             configuration_sha256=hashlib.sha256(record_raw).hexdigest(),sha256=digest.hexdigest())
                    if software in ('forge','neoforge','fabric','quilt'):
                        m['loader_version'] = record['runtime']['loader_version']
                    if software == 'pufferfish' and 'pufferfish_build' in record['runtime']:
                        m['pufferfish_build'] = record['runtime']['pufferfish_build']
                    encoded = json.dumps(m,separators=(',',':')).encode()
                    if len(encoded)>16384:
                        raise ValueError('metadata bound')
                    # Claim cleanup ownership with O_EXCL before writing.
                    meta_fd = os.open(meta_tmp,os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW,0o600,dir_fd=fd)
                    owned.add(meta_tmp)
                    with os.fdopen(meta_fd,'wb') as metadata:
                        metadata.write(encoded)
                        metadata.flush()
                        os.fsync(metadata.fileno())
                    # link() is an atomic no-replace publication on supported
                    # local/NFS/SMB targets; unsupported targets fail safely.
                    os.link(tmp,filename,src_dir_fd=fd,dst_dir_fd=fd,follow_symlinks=False)
                    os.unlink(tmp,dir_fd=fd)
                    sync_dir(fd)
                    os.link(meta_tmp,filename+'.meta.json',src_dir_fd=fd,dst_dir_fd=fd,follow_symlinks=False)
                    os.unlink(meta_tmp,dir_fd=fd)
                    sync_dir(fd)
                    validate_meta(fd,filename)
                finally:
                    for partial in owned:
                        try: os.unlink(partial,dir_fd=fd)
                        except FileNotFoundError: pass
    finally:
        if fd is not None: os.close(fd)
        os.close(root_fd)
except Exception:
    # Never print exception text, private records, paths, tool output or secrets.
    print('ERROR: instance backup storage or archive operation failed.',file=sys.stderr)
    raise SystemExit(1)
PY

