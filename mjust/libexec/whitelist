#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
require_root
require_config

[[ $(systemctl is-active minecraft.service 2>/dev/null || true) == active ]] || {
    echo 'ERROR: Minecraft must be running for whitelist operations.' >&2
    exit 1
}

action="${1:-list}"
name="${2:-}"

run_rcon() {
    podman exec minecraft rcon-cli "$1"
}

case "${action}" in
    list)
        run_rcon 'whitelist list'
        ;;
    add-java|remove-java)
        [[ ${name} =~ ^[A-Za-z0-9_]{1,16}$ ]] || {
            echo 'ERROR: Java player name must contain only letters, numbers, or underscore and be at most 16 characters.' >&2
            exit 1
        }
        if [[ ${action} == add-java ]]; then verb=add; else verb=remove; fi
        run_rcon "whitelist ${verb} ${name}"
        run_rcon 'whitelist list'
        ;;
    add-bedrock|remove-bedrock)
        [[ ${BEDROCK_ENABLED} == yes ]] || { echo 'ERROR: Bedrock cross-play is disabled.' >&2; exit 1; }
        [[ -n ${name} && ${name} != *$'\n'* && ${name} != *$'\r'* && ${#name} -le 64 ]] || {
            echo 'ERROR: invalid Bedrock gamertag.' >&2
            exit 1
        }
        if [[ ${action} == add-bedrock ]]; then verb=add; else verb=remove; fi
        run_rcon "fwhitelist ${verb} ${name}"
        run_rcon 'whitelist list'
        ;;
    *)
        echo 'Usage: whitelist {list|add-java|remove-java|add-bedrock|remove-bedrock} [name]' >&2
        exit 2
        ;;
esac
