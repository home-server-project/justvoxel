#!/usr/bin/bash
set -euo pipefail

action="${1:-}"
archive="${2:-}"
destination="${3:-}"

case "${action}" in
    inspect|extract-world|extract-full) ;;
    *)
        echo 'Usage: restore-archive {inspect|extract-world|extract-full} ARCHIVE [DESTINATION]' >&2
        exit 2
        ;;
esac
[[ -f ${archive} ]] || { echo "ERROR: archive does not exist: ${archive}" >&2; exit 1; }
if [[ ${action} != inspect && -z ${destination} ]]; then
    echo 'ERROR: extraction destination is required.' >&2
    exit 2
fi

python3 - "${action}" "${archive}" "${destination}" <<'PY'
import json
import os
import pathlib
import shutil
import sys
import tarfile


action, archive, destination = sys.argv[1:4]


def fail(message):
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def safe_parts(name):
    if not name or "\x00" in name or any(ord(ch) < 32 for ch in name):
        fail("archive contains an empty or control-character path")
    path = pathlib.PurePosixPath(name)
    if path.is_absolute():
        fail(f"archive contains an absolute path: {name}")
    parts = []
    for part in path.parts:
        if part in ("", "."):
            continue
        if part == "..":
            fail(f"archive contains path traversal: {name}")
        parts.append(part)
    if not parts:
        fail(f"archive contains an invalid path: {name}")
    return parts


def java_property(text, key, default=None):
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#") or line.startswith("!"):
            continue
        if "=" in line:
            k, value = line.split("=", 1)
        elif ":" in line:
            k, value = line.split(":", 1)
        else:
            continue
        if k.strip() == key:
            return value.strip().replace(r"\ ", " ")
    return default


try:
    tf = tarfile.open(archive, mode="r:gz")
except (tarfile.TarError, OSError) as exc:
    fail(f"could not open backup archive: {exc}")

with tf:
    members = tf.getmembers()
    if not members:
        fail("backup archive is empty")

    normalized = []
    seen = set()
    roots = set()
    total_bytes = 0

    for member in members:
        parts = safe_parts(member.name)
        normalized_name = "/".join(parts)
        if normalized_name in seen:
            fail(f"archive contains duplicate path: {normalized_name}")
        seen.add(normalized_name)
        roots.add(parts[0])

        if not (member.isdir() or member.isreg() or member.issym() or member.islnk()):
            fail(f"archive contains an unsupported special file: {member.name}")
        if member.isreg():
            if member.size < 0:
                fail(f"archive contains an invalid file size: {member.name}")
            total_bytes += member.size
        normalized.append((member, parts))

    if len(roots) != 1:
        fail("backup archive must contain exactly one top-level Minecraft data directory")
    root = next(iter(roots))

    # Links are allowed only when they remain inside the one archived Minecraft
    # root. A symlink may not be an ancestor of another archive member, which
    # prevents later extraction from traversing through a link. Hardlinks are
    # restored as ordinary file copies rather than filesystem hardlinks.
    symlink_paths = set()
    for member, parts in normalized:
        normalized_name = "/".join(parts)
        if member.issym():
            linkname = member.linkname
            if not linkname or "\x00" in linkname or any(ord(ch) < 32 for ch in linkname):
                fail(f"archive contains an unsafe symlink target: {member.name}")
            link_path = pathlib.PurePosixPath(linkname)
            if link_path.is_absolute():
                fail(f"archive contains an absolute symlink target: {member.name}")
            stack = list(parts[:-1])
            for part in link_path.parts:
                if part in ("", "."):
                    continue
                if part == "..":
                    if len(stack) <= 1:
                        fail(f"archive symlink escapes the Minecraft data root: {member.name}")
                    stack.pop()
                else:
                    stack.append(part)
            if not stack or stack[0] != root:
                fail(f"archive symlink escapes the Minecraft data root: {member.name}")
            symlink_paths.add(normalized_name)
        elif member.islnk():
            target_parts = safe_parts(member.linkname)
            if target_parts[0] != root:
                fail(f"archive hardlink escapes the Minecraft data root: {member.name}")

    for member, parts in normalized:
        for index in range(1, len(parts)):
            if "/".join(parts[:index]) in symlink_paths:
                fail(f"archive contains content beneath a symlink: {member.name}")

    server_props = f"{root}/server.properties"
    level_name = "world"
    for member, parts in normalized:
        if "/".join(parts) == server_props and member.isreg():
            if member.size > 1024 * 1024:
                fail("server.properties in the backup is unexpectedly large")
            source = tf.extractfile(member)
            if source is None:
                fail("could not read server.properties from the backup")
            text = source.read().decode("iso-8859-1", errors="replace")
            level_name = java_property(text, "level-name", "world") or "world"
            break

    if (
        level_name in (".", "..")
        or "/" in level_name
        or "\\" in level_name
        or "\x00" in level_name
        or any(ord(ch) < 32 for ch in level_name)
    ):
        fail(f"backup has an unsafe level-name: {level_name!r}")

    world_dirs = [level_name, f"{level_name}_nether", f"{level_name}_the_end"]
    world_prefixes = {f"{root}/{name}" for name in world_dirs}
    world_bytes = 0
    primary_present = False

    for member, parts in normalized:
        normalized_name = "/".join(parts)
        for prefix in world_prefixes:
            if normalized_name == prefix or normalized_name.startswith(prefix + "/"):
                if prefix == f"{root}/{level_name}":
                    primary_present = True
                if member.isreg():
                    world_bytes += member.size
                break

    summary = {
        "root": root,
        "levelName": level_name,
        "worldDirectories": world_dirs,
        "primaryWorldPresent": primary_present,
        "totalBytes": total_bytes,
        "worldBytes": world_bytes,
    }

    if action == "inspect":
        print(json.dumps(summary, separators=(",", ":")))
        raise SystemExit(0)

    if action == "extract-world" and not primary_present:
        fail(f"backup does not contain the primary world directory: {level_name}")

    destination_path = pathlib.Path(destination)
    if destination_path.exists():
        fail(f"restore staging destination already exists: {destination}")
    destination_path.mkdir(parents=True, mode=0o700)
    destination_real = destination_path.resolve()

    def selected(parts):
        if action == "extract-full":
            return True
        if len(parts) < 2 or parts[0] != root:
            return False
        return parts[1] in world_dirs

    try:
        for member, parts in normalized:
            if not selected(parts):
                continue

            target = destination_path.joinpath(*parts)
            target_parent = target.parent
            target_parent.mkdir(parents=True, exist_ok=True)
            target_real_parent = target_parent.resolve()
            if os.path.commonpath([str(destination_real), str(target_real_parent)]) != str(destination_real):
                fail(f"archive extraction would escape staging: {member.name}")

            if member.isdir():
                target.mkdir(parents=True, exist_ok=True)
                os.chmod(target, member.mode & 0o777)
                continue
            if member.issym():
                # Symlinks are created after regular content so extraction can
                # never write through a link.
                continue

            source = tf.extractfile(member)
            if source is None:
                fail(f"could not read archived file: {member.name}")
            if target.exists():
                fail(f"archive extraction path already exists: {member.name}")
            with open(target, "xb") as output:
                shutil.copyfileobj(source, output, length=1024 * 1024)
            os.chmod(target, member.mode & 0o777)
            try:
                os.utime(target, (member.mtime, member.mtime), follow_symlinks=False)
            except (OSError, OverflowError, ValueError):
                pass

        for member, parts in normalized:
            if not selected(parts) or not member.issym():
                continue
            target = destination_path.joinpath(*parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            if target.exists() or target.is_symlink():
                fail(f"archive extraction path already exists: {member.name}")
            os.symlink(member.linkname, target)
    except BaseException:
        shutil.rmtree(destination_path, ignore_errors=True)
        raise

    print(json.dumps(summary, separators=(",", ":")))
PY
