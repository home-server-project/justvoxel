#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/common.sh
source /usr/libexec/justvoxel/mjust/os-common.sh
require_root

status_json="$(jv_bootc_status_json 2>/dev/null || true)"
if [[ -z ${status_json} ]] || ! jv_bootc_validate_status_json "${status_json}"; then
    echo 'ERROR: could not read bootc deployment status.' >&2
    exit 1
fi

printf 'JustVoxel operating system\n'
printf '%s\n\n' '--------------------------'
jv_bootc_print_entry "${status_json}" booted 'Running image'
echo
jv_bootc_print_entry "${status_json}" staged 'Staged update'
if jv_bootc_staged_exists "${status_json}"; then
    echo '  State:   Ready for the next reboot'
fi
echo
jv_bootc_print_entry "${status_json}" rollback 'Rollback image'

if [[ $(jv_bootc_read_only "${status_json}") == true ]]; then
    echo
    echo 'OS updates: unavailable because this bootc system is read-only.'
fi
