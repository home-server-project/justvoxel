#!/usr/bin/bash
set -euo pipefail
source /usr/libexec/justvoxel/mjust/ui.sh

mode=simple
if [[ ${1:-} == --advanced ]]; then
    mode=advanced
    shift
fi
if (( $# > 0 )); then
    echo 'Usage: logs [--advanced]' >&2
    exit 2
fi

if [[ ${mode} == simple ]]; then
    journal_args=(--no-pager -o cat -u minecraft.service -n 100)
    title='Minecraft logs'
else
    journal_args=(--no-pager -u minecraft.service -n 200)
    title='Minecraft logs - advanced systemd view'
fi

if ! jui_has_tty; then
    exec journalctl "${journal_args[@]}"
fi

printf '%s\n' "${title}"
printf '%*s\n' "${#title}" '' | tr ' ' '-'
echo 'Press q or Esc to return to JustVoxel. Ctrl-C also exits the log viewer.'
echo

journalctl "${journal_args[@]}" -f &
log_pid=$!

cleanup() {
    local rc=$?
    trap - EXIT INT TERM HUP
    kill "${log_pid}" >/dev/null 2>&1 || true
    wait "${log_pid}" 2>/dev/null || true
    return "${rc}"
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP

while true; do
    key=''
    IFS= read -rsn1 key </dev/tty || break
    case "${key}" in
        q|Q|$'\e') break ;;
    esac
done
