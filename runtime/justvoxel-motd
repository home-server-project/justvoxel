#!/usr/bin/bash
set -u

pretty_name='JustVoxel'
if [[ -r /etc/os-release ]]; then
    # shellcheck disable=SC1091
    source /etc/os-release
    pretty_name="${PRETTY_NAME:-JustVoxel}"
fi

variant_id="$(cat /usr/lib/justvoxel/variant 2>/dev/null || true)"
case "${variant_id}" in
    justvoxel-vm) variant='VM' ;;
    justvoxel-baremetal) variant='Bare Metal' ;;
    *) variant='Unknown' ;;
esac

host="$(cat /proc/sys/kernel/hostname 2>/dev/null || true)"
host="${host%%.*}"
[[ -n ${host} ]] || host='unknown'

ipv4="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i == "src") {print $(i+1); exit}}')"
if [[ -z ${ipv4} ]]; then
    ipv4="$(ip -o -4 addr show scope global up 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')"
fi
[[ -n ${ipv4} ]] || ipv4='Not assigned'

if [[ -f /etc/containers/systemd/minecraft.container ]]; then
    minecraft_state='Configured'
    needs_setup=no
else
    minecraft_state='Not configured'
    needs_setup=yes
fi

web_state='Disabled'
web_browser=''
web_direct=''
web_enabled_marker=/var/lib/justvoxel/webui/enabled
web_initialized_marker=/var/lib/justvoxel/webui/initialized

# Prefer the live listener over bootstrap marker timing. An interactive login can
# happen while bootstrap is writing its final markers even though the WebUI is
# already ready to use.
if systemctl is-active --quiet justvoxel-webui.service 2>/dev/null && \
    curl -fsS --max-time 1 http://127.0.0.1:8099/healthz >/dev/null 2>&1; then
    web_state='Ready'
    if [[ ${host} != unknown ]]; then
        web_browser="http://${host}.local:8099"
    else
        web_browser='Waiting for hostname'
    fi
    if [[ ${ipv4} == 'Not assigned' ]]; then
        web_direct='Waiting for network address'
    else
        web_direct="http://${ipv4}:8099"
    fi
elif systemctl is-failed --quiet justvoxel-web-bootstrap.service 2>/dev/null; then
    web_state='Unavailable'
elif [[ -e ${web_enabled_marker} ]]; then
    web_state='Unavailable'
elif [[ ! -e ${web_initialized_marker} ]]; then
    web_state='Starting...'
else
    web_state='Disabled'
fi

if [[ -t 1 && ${TERM:-dumb} != dumb ]]; then
    green=$'\033[38;5;82m'
    bold=$'\033[1m'
    reset=$'\033[0m'
else
    green=''
    bold=''
    reset=''
fi

printf '%s%sWelcome to JustVoxel%s\n' "${green}" "${bold}" "${reset}"
printf 'Minecraft Server Appliance\n\n'
printf '  System:          %s\n' "${pretty_name}"
printf '  Variant:         %s\n' "${variant}"
printf '  Host:            %s\n' "${host}"
printf '  IPv4:            %s\n' "${ipv4}"
printf '  Minecraft:       %s\n\n' "${minecraft_state}"
printf '  Web interface:   %s\n' "${web_state}"
case "${web_state}" in
    Ready)
        printf '  Open in browser: %s\n' "${web_browser}"
        printf '  Direct address:  %s\n' "${web_direct}"
        ;;
    Disabled)
        printf '  Enable with:     %smjust web enable%s\n' "${green}" "${reset}"
        ;;
    Unavailable)
        printf '  Check status:    %smjust web status%s\n' "${green}" "${reset}"
        ;;
esac
printf '\n'

if [[ ${needs_setup} == yes ]]; then
    printf '  Normal setup:      %smjust setup%s\n' "${green}" "${reset}"
    printf '  Advanced setup:    %smjust setup-advanced%s\n' "${green}" "${reset}"
fi
printf '  Admin menu:        %smjust%s\n' "${green}" "${reset}"
printf '  List commands:     %smjust --list%s\n' "${green}" "${reset}"
printf '  Server status:     %smjust status%s\n' "${green}" "${reset}"
printf '  Web status:        %smjust web status%s\n' "${green}" "${reset}"
printf '  Validate system:   %smjust validate%s\n' "${green}" "${reset}"
printf '\n'
printf '  Documentation: https://github.com/home-server-project/justvoxel\n'
printf '  Report an issue: https://github.com/home-server-project/justvoxel/issues\n'
printf '  Hide this message: mjust welcome-off\n'
