#!/usr/bin/bash
set -Eeuo pipefail

readonly config_file="/etc/justvoxel/minecraft-backup.env"
readonly lock_file="/run/justvoxel-minecraft-maintenance.lock"
leave_stopped=0

while (( $# > 0 )); do
    case "$1" in
        --leave-stopped) leave_stopped=1 ;;
        *)
            echo "ERROR: unknown minecraft-backup option: $1" >&2
            exit 2
            ;;
    esac
    shift
done

if [[ ${EUID} -ne 0 ]]; then
    echo "ERROR: minecraft-backup must run as root." >&2
    exit 1
fi

if [[ ! -r "${config_file}" ]]; then
    echo "ERROR: backup configuration is missing: ${config_file}" >&2
    exit 1
fi

# shellcheck disable=SC1090
source "${config_file}"

: "${MINECRAFT_DATA_PATH:?MINECRAFT_DATA_PATH must be configured}"
: "${MINECRAFT_BACKUP_PATH:?MINECRAFT_BACKUP_PATH must be configured}"

MINECRAFT_SERVICE="${MINECRAFT_SERVICE:-minecraft.service}"
BACKUP_TYPE="${BACKUP_TYPE:-}"
if [[ -z ${BACKUP_TYPE} ]]; then
    if [[ -n ${BACKUP_EXPECTED_UUID:-} ]]; then
        BACKUP_TYPE=local
    elif [[ ${BACKUP_EXPECTED_SOURCE:-} == //* ]]; then
        BACKUP_TYPE=smb
    elif [[ -n ${BACKUP_EXPECTED_SOURCE:-} ]]; then
        BACKUP_TYPE=nfs
    else
        BACKUP_TYPE=system
    fi
fi
BACKUP_KEEP="${BACKUP_KEEP:-7}"
BACKUP_MOUNT_POINT="${BACKUP_MOUNT_POINT:-}"
BACKUP_EXPECTED_UUID="${BACKUP_EXPECTED_UUID:-}"
BACKUP_EXPECTED_SOURCE="${BACKUP_EXPECTED_SOURCE:-}"

if [[ "${MINECRAFT_DATA_PATH}" != /* || "${MINECRAFT_BACKUP_PATH}" != /* ]]; then
    echo "ERROR: Minecraft data and backup paths must be absolute." >&2
    exit 1
fi
if [[ "${MINECRAFT_DATA_PATH}" == "/" || "${MINECRAFT_BACKUP_PATH}" == "/" ]]; then
    echo "ERROR: refusing to use / as a Minecraft data or backup path." >&2
    exit 1
fi
if [[ ! "${BACKUP_KEEP}" =~ ^[1-9][0-9]*$ ]]; then
    echo "ERROR: BACKUP_KEEP must be a positive integer." >&2
    exit 1
fi

minecraft_data_path="$(realpath -m -- "${MINECRAFT_DATA_PATH}")"
minecraft_backup_path="$(realpath -m -- "${MINECRAFT_BACKUP_PATH}")"

if [[ "${minecraft_backup_path}" == "${minecraft_data_path}" || "${minecraft_backup_path}" == "${minecraft_data_path}/"* ]]; then
    echo "ERROR: backup path must not be the Minecraft data directory or a child of it." >&2
    exit 1
fi
if [[ ! -d "${minecraft_data_path}" ]]; then
    echo "ERROR: Minecraft data directory does not exist: ${minecraft_data_path}" >&2
    exit 1
fi

if [[ -n "${BACKUP_MOUNT_POINT}" ]]; then
    if [[ "${BACKUP_MOUNT_POINT}" != /* ]]; then
        echo "ERROR: BACKUP_MOUNT_POINT must be absolute." >&2
        exit 1
    fi
    backup_mount_point="$(realpath -m -- "${BACKUP_MOUNT_POINT}")"
    if ! mountpoint -q -- "${backup_mount_point}"; then
        echo "ERROR: configured backup mount is not mounted: ${backup_mount_point}" >&2
        exit 1
    fi
    case "${minecraft_backup_path}/" in
        "${backup_mount_point}/"*) ;;
        *)
            echo "ERROR: backup path is outside configured backup mount: ${backup_mount_point}" >&2
            exit 1
            ;;
    esac
    if [[ -n "${BACKUP_EXPECTED_UUID}" ]]; then
        actual_uuid="$(findmnt -n -o UUID --target "${backup_mount_point}" 2>/dev/null || true)"
        if [[ "${actual_uuid}" != "${BACKUP_EXPECTED_UUID}" ]]; then
            echo "ERROR: backup mount UUID mismatch; expected ${BACKUP_EXPECTED_UUID}, got ${actual_uuid:-unknown}." >&2
            exit 1
        fi
    fi
    if [[ -n "${BACKUP_EXPECTED_SOURCE}" ]]; then
        actual_source="$(findmnt -n -o SOURCE --target "${backup_mount_point}" 2>/dev/null || true)"
        if [[ "${actual_source}" != "${BACKUP_EXPECTED_SOURCE}" ]]; then
            echo "ERROR: backup mount source mismatch; expected ${BACKUP_EXPECTED_SOURCE}, got ${actual_source:-unknown}." >&2
            exit 1
        fi
    fi
fi

if [[ ${BACKUP_TYPE} == nfs || ${BACKUP_TYPE} == smb ]]; then
    # Network shares can use server-side ownership rules or NFS root-squash.
    # Do not require local chown semantics; require that root can actually write.
    mkdir -p -- "${minecraft_backup_path}"
else
    install -d -m0700 -o root -g root "${minecraft_backup_path}"
fi
if [[ ! -w "${minecraft_backup_path}" ]]; then
    echo "ERROR: backup path is not writable: ${minecraft_backup_path}" >&2
    exit 1
fi
write_probe="$(mktemp "${minecraft_backup_path}/.justvoxel-write-test.XXXXXX" 2>/dev/null)" || {
    echo "ERROR: backup path failed an actual write test: ${minecraft_backup_path}" >&2
    exit 1
}
rm -f -- "${write_probe}"

if [[ ${JUSTVOXEL_MAINTENANCE_LOCK_HELD:-0} != 1 ]]; then
    exec 9>"${lock_file}"
    if ! flock -n 9; then
        echo "ERROR: another JustVoxel Minecraft maintenance operation is already running." >&2
        exit 1
    fi
fi

minecraft_source_parent="$(dirname -- "${minecraft_data_path}")"
minecraft_source_name="$(basename -- "${minecraft_data_path}")"
minecraft_timestamp="$(date +%F-%H%M%S)"
minecraft_final_archive="${minecraft_backup_path}/minecraft-${minecraft_timestamp}.tar.gz"
minecraft_partial_archive="${minecraft_final_archive}.partial"
minecraft_restart_required=0

cleanup() {
    local result=$?
    trap - EXIT
    if [[ -n "${minecraft_partial_archive:-}" && -f "${minecraft_partial_archive}" ]]; then
        rm -f -- "${minecraft_partial_archive}"
    fi
    if (( minecraft_restart_required )); then
        echo "Starting ${MINECRAFT_SERVICE} after backup interruption or failure"
        if ! systemctl start "${MINECRAFT_SERVICE}"; then
            echo "ERROR: ${MINECRAFT_SERVICE} did not restart." >&2
            result=1
        fi
    fi
    exit "${result}"
}
trap cleanup EXIT

find "${minecraft_backup_path}" -maxdepth 1 -type f \
    -name 'minecraft-*.tar.gz.partial' -mmin +1440 -delete

if systemctl is-active --quiet "${MINECRAFT_SERVICE}"; then
    echo "Minecraft is running; stopping through its configured graceful shutdown path"
    minecraft_restart_required=1
    systemctl stop "${MINECRAFT_SERVICE}"
else
    echo "Minecraft was already stopped; it will remain stopped after backup"
fi

if systemctl is-active --quiet "${MINECRAFT_SERVICE}"; then
    echo "ERROR: ${MINECRAFT_SERVICE} is still active." >&2
    exit 1
fi

echo "Creating ${minecraft_final_archive}"
tar -C "${minecraft_source_parent}" -czf "${minecraft_partial_archive}" "${minecraft_source_name}"

echo "Verifying new archive"
tar -tzf "${minecraft_partial_archive}" >/dev/null
mv -- "${minecraft_partial_archive}" "${minecraft_final_archive}"
minecraft_partial_archive=""

mapfile -t minecraft_archives < <(
    find "${minecraft_backup_path}" -maxdepth 1 -type f \
        -name 'minecraft-*.tar.gz' -printf '%T@ %p\n' \
        | sort -nr \
        | cut -d' ' -f2-
)
if (( ${#minecraft_archives[@]} > BACKUP_KEEP )); then
    for (( index=BACKUP_KEEP; index<${#minecraft_archives[@]}; index++ )); do
        echo "Removing expired backup: ${minecraft_archives[index]}"
        rm -f -- "${minecraft_archives[index]}"
    done
fi

if (( minecraft_restart_required )); then
    if (( leave_stopped )); then
        echo "Backup completed; leaving ${MINECRAFT_SERVICE} stopped for the calling maintenance operation"
        minecraft_restart_required=0
    else
        echo "Starting ${MINECRAFT_SERVICE}"
        systemctl start "${MINECRAFT_SERVICE}"
        minecraft_restart_required=0
    fi
fi

echo "Backup completed successfully"
du -h "${minecraft_final_archive}"
