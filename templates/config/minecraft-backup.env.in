# No storage path is hardcoded by the image. mjust renders administrator choices.
MINECRAFT_DATA_PATH=@@DATA_PATH@@
MINECRAFT_BACKUP_PATH=@@BACKUP_PATH@@
MINECRAFT_SERVICE=minecraft.service
BACKUP_KEEP=@@BACKUP_KEEP@@

# Leave these empty for a normal directory on the system filesystem.
# For a dedicated disk, dedicated partition, NFS, SMB/CIFS, or another mounted
# filesystem, set BACKUP_MOUNT_POINT and optionally pin the expected UUID/source.
BACKUP_MOUNT_POINT=@@BACKUP_MOUNT_POINT@@
BACKUP_EXPECTED_UUID=@@BACKUP_EXPECTED_UUID@@
BACKUP_EXPECTED_SOURCE=@@BACKUP_EXPECTED_SOURCE@@
